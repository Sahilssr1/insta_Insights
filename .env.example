# ---------------------------------------------------------------------------
# InsightBoard — Instagram Analytics
# Copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# development | production
ENVIRONMENT=development

# Async DB URL. Dev default is local SQLite; production example:
# postgresql+asyncpg://user:pass@localhost:5432/insightboard
DATABASE_URL=sqlite+aiosqlite:///./insightboard.db

# --- App auth (local accounts) ---
# CHANGE in production to a long random string (min 32 chars).
JWT_SECRET=change-me-in-production
# JWT lifetime in minutes (default 7 days)
JWT_EXPIRE_MINUTES=10080

# --- Instagram token encryption at rest ---
# Fernet key (base64 urlsafe, 32 bytes). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production (the app refuses to boot without it there).
TOKEN_ENCRYPTION_KEY=

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Meta / Instagram (see META_INSTAGRAM_SETUP.md) ---
META_APP_ID=
META_APP_SECRET=
# Must EXACTLY match a redirect URI registered in the Meta app dashboard.
META_REDIRECT_URI=http://localhost:8000/api/instagram/callback
# Graph API version, e.g. v26.0
META_API_VERSION=v26.0

# --- Data provider ---
# "meta" = real Meta/Instagram official APIs (required in production).
# "mock" = clearly-labelled development fixtures. Refused in production.
INSTAGRAM_PROVIDER=meta

# --- Sync behaviour ---
SYNC_ACCOUNT_INSIGHT_DAYS=30
SYNC_MEDIA_LIMIT=50
SYNC_MIN_INTERVAL_SECONDS=300
